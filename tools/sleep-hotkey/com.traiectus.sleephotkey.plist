<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.traiectus.sleephotkey</string>
	<key>ProgramArguments</key>
	<array>
		<string>__APP__/Contents/MacOS/SleepHotKey</string>
		<string>--keycode</string>
		<string>18</string>
		<string>--modifiers</string>
		<string>256</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/sleep-hotkey.err.log</string>
</dict>
</plist>
