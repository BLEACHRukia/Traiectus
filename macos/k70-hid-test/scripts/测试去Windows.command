#!/bin/bash
# ============================================================================
#  K70 键盘：发一次 "→SLIPSTREAM"（把键盘交给 Windows）
# ----------------------------------------------------------------------------
#  双击运行（会打开一个终端窗口）。它做的事：
#    用 Mac 侧已验证的 1025 字节路径，往键盘的厂商接口写一次
#        00 08 01 3A 00 01  + 补零到 1024 字节
#    只发一次：不重试、不循环、不后台。
#
#  为什么这么做：这次要验证的是那个从没验证过的假设 ——
#    键盘的 USB 线插在 Mac 上时，发 →SLIPSTREAM 它会不会当场离开 Mac 去 Windows。
#    会走 = "线常插 Mac + 软件发命令"就能零按键双向切换；
#    不走 = 有线优先，确认，继续用 Fn 组合键。
#
#  需要：键盘的 USB 线插在 Mac 上（否则找不到设备）。
#        终端需要"输入监控"权限（之前已经给过了）。
#
#  兜底：键盘上按 Fn + T 立刻回 Mac。
# ============================================================================

# 切到脚本自己所在的上一级目录（不写死任何人的家目录，换台机器也能双击运行）
cd "$(dirname "$0")/.." || exit 1

echo "==== K70：发一次 →SLIPSTREAM（只发一次，不重试）===="
echo

./build/K70HIDTest test-slipstream --confirm

echo
echo "==== 接下来请这样做 ===="
echo "1) 在 Mac 上随便找个能打字的地方（备忘录 / 浏览器地址栏），敲几个字母："
echo "     打不出字  = 键盘当场去了 Windows（成功）"
echo "     还能打字  = 键盘留在 Mac（有线优先，结论定案）"
echo "2) 再到 Windows 的记事本敲几个字母，确认字符出现在哪一边"
echo "3) 想立刻拿回键盘：在键盘上按 Fn + T"
echo
echo "（这个窗口 90 秒后自动关闭，也可以点右上角 X）"
sleep 90
